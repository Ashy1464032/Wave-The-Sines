[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=3
window/size/borderless=true
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/curved_lines_2d/plugin.cfg")

